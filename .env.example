# ── Existing integrations ─────────────────────────────────────────────
# LeetCode API (your Dockerized instance)
NEXT_PUBLIC_LEETCODE_API_BASE_URL=

# Codeforces API
NEXT_PUBLIC_CODEFORCES_API_BASE_URL=
NEXT_PUBLIC_CODEFORCES_KEY=
NEXT_PUBLIC_CODEFORCES_SECRET=

# ── Database (Supabase Postgres) ──────────────────────────────────────
# Pooled connection (port 6543, pgbouncer) — used by the app at runtime.
# Supabase → Project Settings → Database → Connection string → "Transaction" pooler.
DATABASE_URL=

# Direct connection — used only for `prisma migrate`.
# Use the "Session" pooler string (pooler host, port 5432); the db.*.supabase.co
# direct host is IPv6-only and unreachable from many networks.
DIRECT_URL=

# ── Background sync ───────────────────────────────────────────────────
# Shared secret for /api/cron/sync. Vercel sends it automatically on cron
# invocations when set in the project env. Generate: openssl rand -hex 32
CRON_SECRET=

# ── Auth.js (NextAuth v5) ─────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# GitHub OAuth app: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# In production, also set:
# AUTH_URL=https://your-deployed-domain.com
